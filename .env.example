# Backend Flask
FLASK_ENV=production
FLASK_DEBUG=0
APP_HOST=0.0.0.0
PORT=5000
SECRET_KEY=colocar_clave_larga_y_aleatoria_aqui
SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true
CORS_ORIGIN=https://midominio.com,https://www.midominio.com
MAX_CONTENT_LENGTH=4194304

# Base de datos MySQL/MariaDB
# Usar DATABASE_URL si el hosting lo entrega en una sola variable.
DATABASE_URL=mysql+pymysql://usuario:contrasena@host:3306/BARBERIA
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BARBERIA

# Frontend React/Vite
# En hosting con proxy al mismo dominio puede usarse /api.
VITE_API_URL=https://api.midominio.com/api

# WhatsApp / Meta Cloud API, opcional
BARBERSHOP_ADDRESS=Wicho's Barber Shop
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Administrador inicial, solo para ejecutar backend/scripts/create_admin.py
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=colocar_contrasena_segura_temporal
