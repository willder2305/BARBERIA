# Backend Flask
FLASK_ENV=development
FLASK_DEBUG=1
APP_HOST=127.0.0.1
PORT=5000
SECRET_KEY=clave-local-de-desarrollo
SESSION_LIFETIME_MINUTES=120
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_CONTENT_LENGTH=4194304

# Base de datos MySQL/MariaDB
# En local con XAMPP se recomiendan DB_* y no DATABASE_URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BARBERIA

# Frontend React/Vite
VITE_API_URL=http://127.0.0.1:5000/api

# WhatsApp / Meta Cloud API, opcional
BARBERSHOP_ADDRESS=Wicho's Barber Shop
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Administrador inicial, solo para ejecutar backend/scripts/create_admin.py
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ClaveLocal123
